# Download a Web application OAuth client JSON from Google Cloud Console and save
# it as credentials.json in the project root. Alternatively set a different path:
# GOOGLE_OAUTH_CREDENTIALS=/absolute/path/to/credentials.json

# Must exactly match the authorized redirect URI configured in Google Cloud Console:
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/oauth2/callback

# Optional; set to the same address as the authorized Gmail mailbox/send-as alias:
GMAIL_FROM_ADDRESS=your.sender@gmail.com

# Local guardrails, not Gmail's API quota:
EMAIL_BATCH_LIMIT=100
EMAIL_DELAY_MS=300

# Optional paths:
# GMAIL_TOKEN_DIR=/Users/you/.email-excel-sender/tokens
